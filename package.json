{
  "name": "volunteerny-app",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "//check:esm": "The app's tsconfig uses moduleResolution 'bundler' for Vite, which permits extensionless relative imports. Vercel runs the server as real ESM (package.json type: module), where those throw ERR_MODULE_NOT_FOUND at load time and take the WHOLE API down \u2014 a 500 on every route, with a green tsc and a working local dev server. This re-checks the server entry points under nodenext, where the missing .js is a compile error. Do not remove it from lint.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit && npm run check:esm",
    "check:esm": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck --esModuleInterop --resolveJsonModule server.ts api/index.ts server/emailTemplates.ts server/appUrl.ts",
    "check:firebase": "tsx scripts/check-firebase.ts",
    "check:signup": "tsx scripts/check-signup.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "check:mfa": "tsx scripts/check-mfa.ts",
    "cleanup:test-data": "tsx scripts/cleanup-test-data.ts",
    "check:security": "npm run build && tsx scripts/check-security.ts",
    "check:flows": "tsx scripts/check-flows.ts",
    "check:lifecycle": "tsx scripts/check-lifecycle.ts",
    "check:concurrency": "tsx scripts/check-concurrency.ts",
    "check:integrity": "tsx scripts/check-integrity.ts",
    "check:email": "tsx scripts/check-email.ts",
    "check:queries": "tsx scripts/check-queries.ts",
    "check:errors": "tsx scripts/check-errors.ts",
    "check:certificate": "tsx scripts/check-certificate.ts",
    "check:hours": "tsx scripts/check-hours.ts",
    "sweep:console": "playwright test tests/e2e/console-sweep.spec.ts --reporter=line",
    "deploy:rules": "tsx scripts/deploy-rules.ts",
    "deploy:indexes": "tsx scripts/deploy-indexes.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "check:backup": "tsx scripts/check-backup.ts",
    "backfill:hours": "tsx scripts/backfill-hours.ts",
    "repair:orphans": "tsx scripts/repair-orphaned-accounts.ts",
    "test": "playwright test",
    "test:offline": "playwright test tests/property-fuzz.spec.ts tests/email-templates.spec.ts tests/opportunity-date.spec.ts tests/otp-store.spec.ts tests/format-date.spec.ts --project=chromium",
    "test:tz": "tsx scripts/check-timezones.ts",
    "test:mutation": "tsx scripts/check-mutations.ts",
    "test:rules": "firebase emulators:exec --only firestore --project vny-rules-test \"playwright test --config playwright.rules.config.ts\""
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "lz-string": "^1.5.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.15.1",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.27.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
