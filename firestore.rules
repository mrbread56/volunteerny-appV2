rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A suspension used to be enforced ONLY by src/routes/guards.tsx — React
    // code running on the machine of the person being suspended. The ID token
    // stayed valid, so a student banned after a safety report could keep
    // applying, filing hours and submitting reports straight through the SDK;
    // the "Account Locked" screen was a suggestion.
    //
    // This costs no extra document access: both helpers below already get()
    // this exact path, and Firestore deduplicates identical get() calls within
    // one evaluation. The applications `list` rule — the one at the 10-access
    // budget — does not call these helpers at all, so it is unaffected.
    function isNotBanned() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true;
    }

    // Two-factor, enforced by the database rather than by React.
    //
    // The MFA gate lived only in src/routes/guards.tsx. Someone holding a
    // stolen password but not the mailbox never loads the React app: they use
    // the Firebase SDK directly and get everything their role permits. The
    // challenge was a suggestion made to the honest.
    //
    // The comparison is the same one src/lib/mfa.ts makes — the mfaVerifiedFor
    // claim against auth_time — and both are read from the SAME signed token,
    // so there is no clock involved and nothing to skew. A token with no claim
    // fails, which is the point.
    //
    // The twoFactorEnabled escape is not a loophole: two-factor is OPTIONAL for
    // students, and a student who has turned it off carries no claim at all.
    // Without this clause every one of them is locked out of the database.
    // Organizations and developers cannot reach it — the users rules refuse any
    // non-student write of `false`, on both create and update.
    //
    // Scope, deliberately: this gates WRITES, through the two role helpers
    // below. It is NOT added to the applications `list` rule, which already
    // spends all ten of Firestore's document accesses per query (exists() +
    // get() on the parent opportunity, times five). Adding an eleventh would
    // break every organization's applicant list at their fifth posting — the
    // exact failure that rule's comment records. Reads therefore remain scoped
    // by ownership alone, which means a stolen password can still READ what
    // that account owns. Closing that needs the read paths restructured, not
    // one more get(); tracked as ROADMAP B16.
    function mfaSatisfied() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('twoFactorEnabled', false) == false ||
             // The support escape hatch, and it MUST be honoured here as well as
             // in src/lib/mfa.ts. scripts/grant-mfa.ts opens this window to
             // unlock an organization whose 2FA code cannot reach them —
             // RUNBOOK step 3. Without this clause the grant let them into the
             // UI and then refused every write they attempted, which is a
             // recovery tool that does not recover anything. Measured against
             // auth_time, which Firebase stamps, rather than any clock the
             // person being let in controls.
             request.auth.token.get('auth_time', 0) < request.auth.token.get('mfaGraceUntil', 0) ||
             request.auth.token.get('mfaVerifiedFor', 0) == request.auth.token.get('auth_time', -1);
    }

    function isVerifiedStudent() {
      return isSignedIn() && (
        isDeveloper() ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' && isNotBanned() && mfaSatisfied())
      );
    }

    function isVerifiedOrg() {
      return isSignedIn() && (
        isDeveloper() ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organization' && isNotBanned() && mfaSatisfied())
      );
    }

    // The bootstrap allowlist. Keep in sync with VITE_DEVELOPER_EMAILS in .env —
    // `npm run deploy:rules` refuses to deploy when the two disagree, because a
    // developer email that is in the app but not here gets the whole Control
    // Room UI and permission-denied on every privileged operation, which reads
    // as "the site is broken" rather than "you are not authorized".
    //
    // Rules cannot read environment variables, so this list has to be literal.
    // It is only the bootstrap: once users/{uid}.role == 'developer' the first
    // clause below carries the session, and an existing developer can promote
    // another account by writing that field (see the /users match block).
    function developerEmails() {
      return ['kiamehrmetanat@gmail.com'];
    }

    function isDeveloper() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer' ||
        // email_verified matters here. Firebase does not require ownership proof
        // to create an account with a given address, so without it anyone could
        // register an unclaimed allowlisted address and be handed developer.
        // Every current developer signs in with Google, which verifies.
        (request.auth.token.email in developerEmails() && request.auth.token.email_verified == true)
      );
    }

    // NEVER call this from an `allow read` or `allow list` rule. On a list
    // query the path wildcard has no single value to bind to, so matches()
    // errors and the whole query is denied — which is why the student
    // dashboard, the org directory and the hours list all came back
    // permission-denied while collections without this check worked fine.
    // Split the rule instead: `allow get` may use isValidId, `allow list` must
    // constrain on resource.data (see /students, which already does this).
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Reading a key that is absent from a map is an EVALUATION ERROR in the
    // rules language, and an erroring condition denies the request. So
    // `data.foo == null` does not mean "foo is absent or null" — it blows up
    // whenever foo is absent, which denied every genuine browser signup
    // (Signup.tsx never sends previousExperience/loggedHours/isBanned) while
    // Admin-SDK test scripts, which bypass rules entirely, looked fine.
    //
    // `data.get(field, null) == null` is the safe form: it returns the default
    // for an absent key and null for a present-but-null one, covering both
    // "optional" cases without ever erroring. Every optional-field check below
    // uses it. Do not reintroduce bare `data.x == null`.
    function absent(data, field) {
      return data.get(field, null) == null;
    }

    // --- Entity Validators ---

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['student', 'organization'] &&
             // Two-factor is optional for students and MANDATORY for everyone
             // else. The update rule below spends four lines enforcing exactly
             // that, and this line used to accept any bool from any role — so
             // an organization could simply be created with it already off,
             // and verifyMfaClaim (src/lib/mfa.ts) short-circuits to "verified"
             // whenever the field is false. The account was never challenged,
             // and the update rule then prevented anyone turning on what had
             // never been on. Create and update have to agree.
             (absent(data, 'twoFactorEnabled') ||
               (data.twoFactorEnabled is bool &&
                 (data.twoFactorEnabled == true || data.role == 'student'))) &&
             data.createdAt == request.time;
    }

    function isValidStudent(data) {
       return data.uid == request.auth.uid &&
              data.fullName is string && data.fullName.size() <= 100 &&
              (absent(data, 'school') || (data.school is string && data.school.size() <= 100)) &&
              (absent(data, 'grade') || data.grade in ['9', '10', '11', '12', '']) &&
              // '' is admitted for the same reason it is admitted for grade
              // directly above: StudentProfile initialises the field to '' when
              // the stored profile has none and sends it on EVERY save, and
              // StudentOnboarding never writes it at all. Without '' here, every
              // student who predates this field is permanently unable to save
              // their profile, with a permission error that names nothing.
              (absent(data, 'gender') || data.gender in ['male', 'female', 'other', '']) &&
              (absent(data, 'neighborhood') || (data.neighborhood is string && data.neighborhood.size() <= 100)) &&
              (absent(data, 'interests') || (data.interests is list && data.interests.size() <= 50)) &&
              (absent(data, 'skills') || (data.skills is list && data.skills.size() <= 50)) &&
              (absent(data, 'availability') || (data.availability is list && data.availability.size() <= 50)) &&
              (absent(data, 'previousExperience') || (data.previousExperience is string && data.previousExperience.size() <= 5000)) &&
              // resumeUrl and passportUrl are not URLs: they hold the whole file
              // as a base64 data URI inside this document. Every other field here
              // is capped and these two were not, which is a resource-exhaustion
              // hole AND a correctness one — Firestore rejects any document over
              // 1 MiB, so an oversized upload made the student's entire profile
              // unsaveable rather than just refusing the file. 400_000 each keeps
              // both plus the rest of the document comfortably under the limit.
              (absent(data, 'resumeUrl') || (data.resumeUrl is string && data.resumeUrl.size() <= 400000)) &&
              (absent(data, 'passportUrl') || (data.passportUrl is string && data.passportUrl.size() <= 400000)) &&
              (absent(data, 'loggedHours') || (data.loggedHours is list && data.loggedHours.size() <= 500)) &&
              (absent(data, 'isBanned') || data.isBanned is bool) &&
              // Both of these are in the create AND update allowlists, and were
              // named by no validator — so they accepted any type at any size,
              // which walks straight around the 400 000 caps above that exist
              // to keep this document under Firestore's 1 MiB ceiling.
              (absent(data, 'trackerEnabled') || data.trackerEnabled is bool) &&
              (absent(data, 'trackerAnonymous') || data.trackerAnonymous is bool);
    }

    function isValidOrganization(data) {
      return data.uid == request.auth.uid &&
             data.organizationName is string && data.organizationName.size() <= 100 &&
             (absent(data, 'mission') || (data.mission is string && data.mission.size() <= 2000)) &&
             data.contactEmail is string &&
             data.northYorkConfirmed is bool &&
             (absent(data, 'phone') || data.phone is string) &&
             (absent(data, 'websiteUrl') || data.websiteUrl is string) &&
             (absent(data, 'organizationType') || data.organizationType is string) &&
             (absent(data, 'address') || data.address is string) &&
             (absent(data, 'isBanned') || data.isBanned is bool) &&
             (absent(data, 'coordinates') || (data.coordinates is map && data.coordinates.lat is number && data.coordinates.lng is number));
    }

    function isValidOpportunity(data) {
      return data.orgId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 5000 &&
             // This collection is `allow read: if true`, so anything unbounded
             // here is downloaded by every unauthenticated visitor to the browse
             // page. title and description were capped; the rest were not.
             data.location is string && data.location.size() <= 300 &&
             data.category is string && data.category.size() <= 100 &&
             (absent(data, 'orgName') || (data.orgName is string && data.orgName.size() <= 200)) &&
             (absent(data, 'requirements') || (data.requirements is string && data.requirements.size() <= 5000)) &&
             // Capacity drives the waitlist. A negative value was accepted and
             // makes "places remaining" nonsense.
             (absent(data, 'maxVolunteers') || (data.maxVolunteers is int && data.maxVolunteers >= 0 && data.maxVolunteers <= 10000)) &&
             (absent(data, 'skillsNeeded') || data.skillsNeeded is list) &&
             (absent(data, 'exclusives') || data.exclusives is list) &&
             (absent(data, 'timeCommitment') || (data.timeCommitment is string && data.timeCommitment.size() <= 100)) &&
             (absent(data, 'isVirtual') || data.isVirtual is bool) &&
             // 'closed' stops new applications without deleting the posting.
             // Absent means open, so every opportunity created before this
             // field existed keeps working with no backfill.
             (absent(data, 'status') || data.status in ['open', 'closed']) &&
             // 'closed' stops new applications without deleting the posting.
             // Absent means open, so every opportunity created before this
             // field existed keeps working with no backfill.
             (absent(data, 'status') || data.status in ['open', 'closed']) &&
             (absent(data, 'scheduleType') || data.scheduleType is string) &&
             (absent(data, 'shifts') || data.shifts is list) &&
             (absent(data, 'coordinates') || (data.coordinates is map && data.coordinates.lat is number && data.coordinates.lng is number)) &&
             // OrgOpportunityEdit writes this on every save. It was in neither
             // this validator nor the update hasOnly below, so hasOnly saw an
             // affected key it did not permit and EVERY organization edit was
             // rejected with permission-denied. Nothing tested editing an
             // opportunity, so it failed silently in production.
             (absent(data, 'updatedAt') || data.updatedAt is timestamp) &&
             data.createdAt == (resource == null ? request.time : resource.data.createdAt);
    }

    function isValidApplication(data) {
       return data.studentId == (resource == null ? request.auth.uid : resource.data.studentId) &&
              data.opportunityId is string &&
              // 'reviewed' is in the Application type and OrgOpportunityApplicants
             // writes it, but it was missing here, so every "Mark as reviewed"
             // click was rejected with permission-denied. It passed in demo mode
             // because demo mode never reaches Firestore.
             data.status in ['pending', 'reviewed', 'accepted', 'rejected', 'terminated', 'waitlist'] &&
              // Every free-text field is size-capped, not just type-checked.
              //
              // rejectionReason and rejectionNote were not mentioned here AT
              // ALL, while the organization branch of `allow update` below
              // permits writing exactly those two keys — so an org could put
              // any type and any size into a student's application, up to the
              // 1 MiB document ceiling. The others were type-checked but
              // unbounded, which is the same hole with an extra step: `is
              // string` says nothing about length, so a single application
              // could still carry most of a megabyte.
              //
              // Caps are deliberately generous — well past anything the forms
              // accept — so they bound abuse without rejecting real writes.
              (absent(data, 'opportunityTitle') || (data.opportunityTitle is string && data.opportunityTitle.size() <= 300)) &&
              (absent(data, 'studentName') || (data.studentName is string && data.studentName.size() <= 300)) &&
              (absent(data, 'previousExperience') || (data.previousExperience is string && data.previousExperience.size() <= 5000)) &&
              (absent(data, 'message') || (data.message is string && data.message.size() <= 5000)) &&
              (absent(data, 'rejectionReason') || (data.rejectionReason is string && data.rejectionReason.size() <= 300)) &&
              (absent(data, 'rejectionNote') || (data.rejectionNote is string && data.rejectionNote.size() <= 2000)) &&
              // When the organization decided, as opposed to when the student
              // applied. The student's notification bell reads this; see the
              // note on the org branch of `allow update`.
              (absent(data, 'decidedAt') || data.decidedAt is timestamp) &&
              data.appliedAt == (resource == null ? request.time : resource.data.appliedAt) &&
              // Same 400 KB cap the student document already enforces. Without it an
             // application could carry most of the 1 MiB document limit.
             (absent(data, 'resumeUrl') || (data.resumeUrl is string && data.resumeUrl.size() <= 400000));
    }

    function isValidSavedOpportunity(data) {
      return data.studentId == request.auth.uid &&
             data.opportunityId is string &&
             data.savedAt == request.time;
    }

    function isValidFeedback(data) {
      return data.userId == request.auth.uid &&
             data.userEmail is string &&
             data.type in ['bug', 'feature', 'ux', 'other'] &&
             data.subject is string && data.subject.size() <= 200 &&
             data.message is string && data.message.size() <= 10000 &&
             (absent(data, 'userRole') || data.userRole is string) &&
             (absent(data, 'id') || data.id is string) &&
             (absent(data, 'attachmentName') || data.attachmentName is string) &&
             (absent(data, 'attachmentSize') || data.attachmentSize is string) &&
             (absent(data, 'attachmentDescription') || data.attachmentDescription is string) &&
             // Capped like resumeUrl/passportUrl above: this is a base64 file
             // upload from the client and it had no size limit at all, so one
             // feedback ticket or safety report could be inflated to the 1 MiB
             // document ceiling.
             (absent(data, 'attachmentData') ||
               (data.attachmentData is string && data.attachmentData.size() <= 400000)) &&
             (absent(data, 'aiOverview') || data.aiOverview is map) &&
             (absent(data, 'developerReply') || data.developerReply is string) &&
             (absent(data, 'repliedAt') || data.repliedAt is string || data.repliedAt is timestamp) &&
             data.createdAt == (resource == null ? request.time : resource.data.createdAt);
    }

    function isValidReport(data) {
      return data.reportingUserId == request.auth.uid &&
             data.reportingUserEmail is string &&
             data.reportedUserId is string &&
             data.reason is string &&
             data.description is string &&
             data.status in ['pending', 'resolved', 'dismissed'] &&
             (absent(data, 'reportingUserName') || data.reportingUserName is string) &&
             (absent(data, 'reportedUserName') || data.reportedUserName is string) &&
             (absent(data, 'reportedUserRole') || data.reportedUserRole is string) &&
             (absent(data, 'id') || data.id is string) &&
             (absent(data, 'attachmentName') || data.attachmentName is string) &&
             (absent(data, 'attachmentSize') || data.attachmentSize is string) &&
             (absent(data, 'attachmentDescription') || data.attachmentDescription is string) &&
             // Capped like resumeUrl/passportUrl above: this is a base64 file
             // upload from the client and it had no size limit at all, so one
             // feedback ticket or safety report could be inflated to the 1 MiB
             // document ceiling. The cap stays even though new reports carry
             // only a Storage URL: documents written before that migration
             // still hold inline base64, and every update to one of them is
             // re-validated through here.
             (absent(data, 'attachmentData') ||
               (data.attachmentData is string && data.attachmentData.size() <= 400000)) &&
             // Current reports store the attachment in Firebase Storage
             // (reports/{uid}/... per storage.rules) and carry only the URL.
             (absent(data, 'attachmentUrl') || data.attachmentUrl is string) &&
             (absent(data, 'aiOverview') || data.aiOverview is map) &&
             data.createdAt == (resource == null ? request.time : resource.data.createdAt);
    }

    // These two exist so `update` can enforce exactly what `create` enforces.
    // Both bodies used to live inline in their `create` rule only, and the
    // matching `update` checked nothing but which keys changed — so the owner
    // could create a valid 1-to-5 rating and then PATCH it to 999999, push the
    // text past its cap, or bolt on arbitrary new fields up to the 1 MiB
    // document limit. Every other collection in this file already re-validates
    // on update; these were the two newest and the two that did not.
    function isValidRecommendation(data) {
      return data.studentId is string &&
             data.opportunityId is string &&
             data.text is string && data.text.size() <= 1000 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidOrgRating(data) {
      return data.orgId is string &&
             data.opportunityId is string &&
             data.stars is number && data.stars >= 1 && data.stars <= 5 &&
             data.comment is string && data.comment.size() <= 500;
    }

    function isValidHoursRequest(data) {
      return data.studentId is string &&
             data.studentName is string &&
             data.studentEmail is string &&
             data.activity is string &&
             data.organization is string &&
             // Bounded. Every other field here is capped; this one was not, so a
             // student could file a request for any number. It could never be
             // credited (the server caps a single approval at 24), but it could
             // fill an organization's queue with absurd claims.
             data.hours is number && data.hours > 0 && data.hours <= 24 &&
             data.date is string &&
             data.coordinatorName is string &&
             data.coordinatorContact is string &&
             data.status in ['pending', 'approved', 'declined'] &&
             data.requestedAt is string &&
             (absent(data, 'id') || (data.id is string && data.id.size() <= 200)) &&
             // Every string here was bare `is string`. `hours` was deliberately
             // bounded and the free text beside it was not, so one request could
             // still carry ~1 MiB into a coordinator's queue, unlimited times.
             data.studentName.size() <= 100 &&
             data.studentEmail.size() <= 200 &&
             data.activity.size() <= 2000 &&
             data.organization.size() <= 200 &&
             data.date.size() <= 40 &&
             data.coordinatorName.size() <= 100 &&
             data.coordinatorContact.size() <= 200 &&
             data.requestedAt.size() <= 40;
    }

    function isValidInterestRequest(data) {
      // createdAt and status are pinned to their EXISTING value on update, and
      // only fixed on create. They were both hard-coded to the create-time
      // values — `createdAt == request.time` and `status == 'pending'` — which
      // can never hold once the document exists: createdAt does not change, so
      // it can never equal "now". That made the whole student branch of
      // `allow update` unreachable, and a student could never edit the interest
      // request they had just filed. Same shape as isValidApplication.
      return data.studentId == request.auth.uid &&
             data.studentName is string && data.studentName.size() <= 300 &&
             data.email is string && data.email.size() <= 320 &&
             data.categories is list && data.categories.size() <= 50 &&
             data.description is string && data.description.size() <= 5000 &&
             data.createdAt == (resource == null ? request.time : resource.data.createdAt) &&
             data.status == (resource == null ? 'pending' : resource.data.status);
    }

    // --- Match Blocks ---

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isDeveloper()) && isValidId(uid);
      // Only the developer console enumerates accounts.
      allow list: if isDeveloper();
      // hasOnly for the same reason the update rule below has one: without it
      // the owner can append arbitrary keys to their own account document up to
      // the 1 MiB ceiling. Not an escalation — nothing reads unknown keys — but
      // unbounded storage attached to every account, billed to us and dragged
      // along by every read of the document.
      allow create: if isSignedIn() && request.auth.uid == uid && isValidId(uid) && isValidUser(incoming()) &&
                      incoming().keys().hasOnly(['uid', 'email', 'role', 'twoFactorEnabled', 'createdAt']);
      // twoFactorEnabled is read by the client MFA gate: when it is false the
      // gate is skipped entirely. This rule previously accepted any bool from
      // the account owner, so an organization or developer could PATCH their
      // own user doc to { twoFactorEnabled: false } and permanently opt out of
      // 2FA. Students may still toggle it (it is optional for them); everyone
      // else may only leave it alone or turn it on.
      // hasOnly is the outer bound, and it matters even though role, uid,
      // createdAt and email are each pinned to their existing value below.
      // Pinning stops those four being CHANGED; it does nothing about fields
      // that were never named. Without hasOnly, the owner could append
      // arbitrary new keys to their own account document up to the 1 MiB
      // ceiling — not a privilege escalation, since nothing reads those keys,
      // but free unbounded storage attached to every account, billed to us and
      // dragged along by every read of the document.
      //
      // twoFactorEnabled is the only field any client screen writes here
      // (src/pages/OrgProfile.tsx and src/pages/StudentDashboard.tsx, both the
      // 2FA toggle). Developers write through the isDeveloper() branch below.
      allow update: if isSignedIn() && request.auth.uid == uid && isValidId(uid) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['twoFactorEnabled']) &&
                      incoming().role == existing().role &&
                      incoming().uid == existing().uid &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().email == existing().email &&
                      (absent(incoming(), 'twoFactorEnabled') || incoming().twoFactorEnabled is bool) &&
                      (
                        incoming().get('twoFactorEnabled', null) == existing().get('twoFactorEnabled', null) ||
                        incoming().get('twoFactorEnabled', null) == true ||
                        existing().role == 'student'
                      );
      allow delete: if false;
      allow read, write: if isDeveloper();
    }

    match /students/{uid} {
      // The student, and developers. NOT organizations.
      //
      // isVerifiedOrg() used to be here, which meant any account with
      // role == 'organization' could read ANY student document given a uid —
      // and these documents carry resumeUrl and passportUrl, whole identity
      // documents base64-encoded inline, for students who are mostly minors.
      // An organization account is free and instant, so that was a standing
      // invitation.
      //
      // Whether a student applied to one of this organization's opportunities
      // is a query, and rules can only read an exact document path, so this
      // could not be narrowed here. Organizations now read through
      // GET /api/students/:id/review-profile, which runs that query and
      // returns an allow-listed subset — deliberately without passportUrl,
      // which no organization-facing screen has ever shown.
      allow get: if isSignedIn() && (isOwner(uid) || isDeveloper()) && isValidId(uid);
      // Only students and developers can run list queries
      allow list: if isSignedIn() && (isOwner(uid) || isDeveloper());
      
      // hasOnly is the outer bound, and it is doing real work here.
      //
      // isValidStudent() below validates thirteen NAMED fields. It says nothing
      // about any field it does not name, and `hours` is not one of them —
      // `hours` is the denormalised total the leaderboard rebuild orders by
      // (server.ts, orderBy('hours','desc')). The update rule pins it, so
      // self-crediting was closed on that path and check-security.ts asserts it
      // with updateDoc. Create was never tested and never bounded: a new
      // account could set { hours: 999999 } in the SAME setDoc that created the
      // profile and rank first on the public board permanently, because
      // students delete is developer-only. Verified against the live project
      // before this line was added.
      //
      // The same gap let a create pad the document with arbitrary unnamed keys
      // up to the 1 MiB ceiling — free storage attached to a free account,
      // dragged along by every read. Identical reasoning to /users above.
      allow create: if isSignedIn() && request.auth.uid == uid && isValidId(uid) && isValidStudent(incoming()) &&
                    incoming().keys().hasOnly(['uid', 'email', 'fullName', 'school', 'grade', 'gender', 'neighborhood', 'interests', 'skills', 'availability', 'previousExperience', 'resumeUrl', 'passportUrl', 'loggedHours', 'isBanned', 'trackerEnabled', 'trackerAnonymous', 'createdAt']) &&
                    incoming().get('hours', 0) == 0 &&
                    (!('loggedHours' in incoming()) || incoming().loggedHours.size() == 0);
      // `hours` is the denormalised total of `loggedHours` and is what the
      // leaderboard rebuild orders by, so it is exactly as self-crediting as the
      // array is: the owner may not touch either. The organization writes both
      // in one updateDoc when it approves hours, so hasOnly must name both —
      // with only ['loggedHours'] the combined write is rejected outright.
      // NO CLIENT may write loggedHours or hours — not the student, and no
      // longer the organization either.
      //
      // There used to be an organization branch here guarded by
      // isVerifiedOrg() && hasOnly(['loggedHours','hours']). hasOnly() restricts
      // WHICH fields are written, never WHOSE document they are written to, and
      // isVerifiedOrg() only checks that the caller's own users doc says
      // role == 'organization' — which anyone gets, free and instantly, by
      // signing up. So any account could credit OR erase the volunteer hours of
      // any student whose uid it knew. Ontario requires 40
      // community-involvement hours to graduate, making that a forged or
      // destroyed graduation record.
      //
      // The missing test is "did this student actually volunteer with this
      // organization", which needs a query across applications and
      // opportunities. Rules can only read an exact document path, so they
      // cannot answer it — no amount of tightening here would have. The
      // authority now lives in POST /api/hours/approve, which runs that query
      // with the Admin SDK (bypassing these rules by design) and writes the
      // array and the total in one transaction.
      //
      // Deliberately no organization branch below. Adding one back re-opens the
      // hole; scripts/check-security.ts asserts it stays shut.
      allow update: if isSignedIn() && isValidId(uid) && (
        (isOwner(uid) && mfaSatisfied() && isValidStudent(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'school', 'grade', 'gender', 'neighborhood', 'interests', 'skills', 'availability', 'previousExperience', 'resumeUrl', 'passportUrl', 'trackerEnabled', 'trackerAnonymous'])) ||
        isDeveloper()
      );
      allow delete: if isDeveloper();
    }

    match /organizations/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      // The student dashboard and the hours-logging form both browse the org
      // directory, so any signed-in user may list it — same exposure the
      // per-document rule already allowed.
      allow list: if isSignedIn();
      // craVerified / verificationStatus are trust signals shown to students
      // choosing who to volunteer with. An organization must never be able to
      // set them on itself - the client used to write craVerified: true purely
      // because the org typed a number, and these rules allowed it, so any org
      // could self-issue a verified badge with a single request.
      // Both trust signals must be pinned on create, not just craVerified.
      //
      // verificationStatus was in the hasOnly allowlist below with no value
      // constraint, so an organization could sign up with
      // { craVerified: false, verificationStatus: 'verified' } and skip human
      // vetting entirely — the developer review queue only lists
      // verificationStatus == 'pending', so a self-verified org never appears
      // in it and is never looked at by a person. Confirmed against the live
      // project before this line was added. The update rule already omits both
      // keys, which is why only the create path was open.
      allow create: if isSignedIn() && request.auth.uid == uid && isValidId(uid) && isValidOrganization(incoming()) &&
                      incoming().get('craVerified', false) == false &&
                      incoming().get('verificationStatus', 'unverified') in ['pending', 'unverified'] &&
                      incoming().keys().hasOnly(['uid', 'organizationName', 'mission', 'description', 'hasCra', 'craNumber', 'organizationType', 'contactEmail', 'phone', 'address', 'coordinates', 'northYorkConfirmed', 'websiteUrl', 'socialLinks', 'craVerified', 'verificationStatus']);
      // verificationStatus is writable by the organization, but ONLY to
      // 'pending' — asking to be reviewed, never declaring the outcome.
      //
      // It was absent from this list entirely, which meant an organization that
      // obtained charitable status after signing up could enter its CRA number,
      // see it saved, and never appear in the reviewer's queue: that queue
      // lists verificationStatus == 'pending' and nothing could ever move a
      // profile into it after creation. craVerified stays pinned to its
      // existing value here, so the actual trust signal remains a decision only
      // a reviewer can make.
      // mfaSatisfied() on UPDATE but deliberately NOT on create: signup writes
      // this profile before any code has been sent, so gating create would make
      // registering an organization impossible.
      allow update: if isSignedIn() && isValidId(uid) && (
        (request.auth.uid == uid && mfaSatisfied() && isValidOrganization(incoming()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['organizationName', 'mission', 'description', 'hasCra', 'craNumber', 'organizationType', 'contactEmail', 'phone', 'address', 'coordinates', 'northYorkConfirmed', 'websiteUrl', 'socialLinks', 'verificationStatus']) &&
         incoming().get('craVerified', false) == existing().get('craVerified', false) &&
         (incoming().get('verificationStatus', '') == existing().get('verificationStatus', '') ||
          incoming().get('verificationStatus', '') == 'pending')) ||
        isDeveloper()
      );
      allow delete: if isDeveloper();
    }

    match /opportunities/{opportunityId} {
      allow read: if true; // Public access to browse
      allow create: if isVerifiedOrg() && isValidOpportunity(incoming()) && isValidId(opportunityId) &&
                      incoming().keys().hasOnly(['orgId', 'orgName', 'title', 'description', 'location', 'dateTime', 'category', 'requirements', 'maxVolunteers', 'skillsNeeded', 'exclusives', 'timeCommitment', 'isVirtual', 'status', 'createdAt', 'coordinates', 'scheduleType', 'shifts']);
      allow update: if isVerifiedOrg() && isValidId(opportunityId) &&
                      existing().orgId == request.auth.uid && 
                      isValidOpportunity(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'dateTime', 'category', 'requirements', 'maxVolunteers', 'skillsNeeded', 'exclusives', 'timeCommitment', 'isVirtual', 'status', 'coordinates', 'scheduleType', 'shifts', 'updatedAt']);
      allow delete: if isVerifiedOrg() && isValidId(opportunityId) && existing().orgId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow get: if isSignedIn() && isValidId(applicationId) && (
        resource.data.studentId == request.auth.uid ||
        (exists(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)) &&
         get(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)).data.orgId == request.auth.uid) ||
        isDeveloper()
      );
      // Same ownership constraint, minus isValidId — see the note on that
      // function. Students list their own applications; an org lists the
      // applications to opportunities it owns.
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        (exists(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)) &&
         get(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)).data.orgId == request.auth.uid) ||
        isDeveloper()
      );
      
      // Allow students to apply either directly (pending) or to waitlist (waitlist).
      //
      // hasOnly bounds the document. isValidApplication caps every field it
      // names, but named nothing about fields it does not — and with document
      // ids unconstrained, a student could create unlimited applications each
      // padded with an unnamed key toward the 1 MiB ceiling. Same reasoning as
      // /users and /students.
      allow create: if isVerifiedStudent() && isValidId(applicationId) && isValidApplication(incoming()) &&
                    incoming().keys().hasOnly(['opportunityId', 'orgId', 'studentId', 'status', 'appliedAt', 'message', 'opportunityTitle', 'studentName', 'previousExperience', 'resumeUrl']) &&
                    (incoming().status == 'pending' || incoming().status == 'waitlist');
                    
      allow update: if isSignedIn() && isValidId(applicationId) && isValidApplication(incoming()) && (
        // Student can withdraw (status changes to terminated) or update message/resume
        (isOwner(existing().studentId) && 
         (incoming().status == existing().status || incoming().status == 'terminated') &&
         incoming().diff(existing()).affectedKeys().hasOnly(['message', 'resumeUrl', 'status'])) ||
        // Org can update status, rejectionReason, rejectionNote and decidedAt.
        //
        // decidedAt is what makes the student's notification bell work. The
        // bell used to timestamp "application accepted" with appliedAt — the
        // moment the STUDENT applied — so a decision made after they last
        // opened the bell always compared as already-seen and the unread badge
        // never appeared for an acceptance, a rejection, or a waitlist move.
        // appliedAt cannot be reused: it is pinned on create and never changes,
        // which is correct. So the decision needs its own stamp.
        (exists(/databases/$(database)/documents/opportunities/$(existing().opportunityId)) &&
         get(/databases/$(database)/documents/opportunities/$(existing().opportunityId)).data.orgId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'rejectionNote', 'decidedAt'])) ||
        isDeveloper()
      );
      allow delete: if isOwner(resource.data.studentId) || isDeveloper();
    }

    match /savedOpportunities/{savedId} {
      allow read: if isOwner(resource.data.studentId) || isDeveloper();
      allow create: if isVerifiedStudent() && isValidSavedOpportunity(incoming()) && isValidId(savedId) && incoming().diff({}).affectedKeys().hasOnly(['studentId', 'opportunityId', 'savedAt']);
      allow delete: if isOwner(resource.data.studentId) || isDeveloper();
    }

    match /feedbacks/{feedbackId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper()) && isValidId(feedbackId);
      // The feedback page lists the tickets you filed; developers list them all.
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && isNotBanned() && incoming().userId == request.auth.uid && isValidId(feedbackId) && isValidFeedback(incoming()) && incoming().diff({}).affectedKeys().hasOnly(['userId', 'userEmail', 'type', 'subject', 'message', 'userRole', 'id', 'attachmentName', 'attachmentSize', 'attachmentDescription', 'attachmentData', 'aiOverview', 'developerReply', 'repliedAt', 'createdAt']);
      allow update: if isSignedIn() && isValidId(feedbackId) && (
        isDeveloper() || 
        (resource.data.userId == request.auth.uid && isValidFeedback(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'subject']))
      );
      allow delete: if isDeveloper();
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && (resource.data.reportingUserId == request.auth.uid || isDeveloper()) && isValidId(reportId);
      allow list: if isSignedIn() && (resource.data.reportingUserId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && isNotBanned() && incoming().reportingUserId == request.auth.uid && isValidId(reportId) && isValidReport(incoming()) && incoming().diff({}).affectedKeys().hasOnly(['reportingUserId', 'reportingUserEmail', 'reportingUserName', 'reportedUserId', 'reportedUserName', 'reportedUserRole', 'reason', 'description', 'status', 'id', 'attachmentName', 'attachmentSize', 'attachmentDescription', 'attachmentData', 'attachmentUrl', 'aiOverview', 'createdAt']);
      allow update, delete: if isDeveloper();
    }

    // The materialised leaderboard. Clients only ever read it; it is built by
    // the server's Admin SDK (POST /api/leaderboard/refresh), which bypasses
    // these rules entirely. Keeping client writes closed to everyone — not even
    // developers — means a compromised dev account cannot forge rankings, and
    // documents the fact that aggregation is deliberately server-only.
    match /leaderboards/{leaderboardId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // OTP request counters, written only by the server's Admin SDK. Exposing
    // these to clients would let a user reset their own rate limit.
    match /otp_rate_limits/{uid} {
      allow read, write: if false;
    }

    // Email request counters, written only by the server's Admin SDK.
    match /email_rate_limits/{uid} {
      allow read, write: if false;
    }

    // The transactional email log behind the developer console. It records the
    // RECIPIENT ADDRESS of every send, which is personal data for people who are
    // mostly minors, so no client may touch it — not even a developer. The
    // Admin SDK writes it and GET /api/email/history reads it there, behind the
    // verified developer allowlist.
    match /emailLog/{entryId} {
      allow read, write: if false;
    }

    match /hoursRequests/{reqId} {
      allow get: if isSignedIn() && isValidId(reqId) && (
        resource.data.studentId == request.auth.uid ||
        // email_verified is required, for the same reason isDeveloper() above
        // requires it: Firebase does not make you prove you own an address to
        // register with it. Without this, anyone could sign up using a
        // coordinator's address and list every hours request sent to it —
        // studentName, studentEmail, activity, hours and date for every student
        // who volunteered with that organization. Organization contactEmail is
        // listable by any signed-in account, so the addresses are harvestable.
        (resource.data.coordinatorContact == request.auth.token.email &&
         request.auth.token.email_verified == true) ||
        isDeveloper()
      );
      // Students list their own logged hours; coordinators list the requests
      // addressed to them.
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        // email_verified is required, for the same reason isDeveloper() above
        // requires it: Firebase does not make you prove you own an address to
        // register with it. Without this, anyone could sign up using a
        // coordinator's address and list every hours request sent to it —
        // studentName, studentEmail, activity, hours and date for every student
        // who volunteered with that organization. Organization contactEmail is
        // listable by any signed-in account, so the addresses are harvestable.
        (resource.data.coordinatorContact == request.auth.token.email &&
         request.auth.token.email_verified == true) ||
        isDeveloper()
      );
      allow create: if isSignedIn() && isNotBanned() && isValidId(reqId) && (
        (incoming().studentId == request.auth.uid && isValidHoursRequest(incoming()) &&
          incoming().status == 'pending' &&
          // The update rule below bounds its keys; this one did not, so a
          // student could attach unnamed fields of any size to every request.
          // 'id' is a real field the client writes: StudentDashboard mints a
          // collision-resistant id and stores it IN the document as well as
          // using it as the document name. Omitting it here made every hours
          // submission in the app fail permission-denied — caught by
          // check:flows, not by the emulator suite, whose fixture did not
          // match the real write.
          incoming().keys().hasOnly(['id', 'studentId', 'studentName', 'studentEmail', 'activity',
                                     'hours', 'date', 'organization', 'coordinatorName',
                                     'coordinatorContact', 'status', 'requestedAt'])) ||
        isDeveloper()
      );
      allow update: if isSignedIn() && isValidId(reqId) && (
        // Only student owner can edit their own pending requests
        (existing().studentId == request.auth.uid && 
         existing().status == 'pending' &&
         isValidHoursRequest(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['activity', 'organization', 'hours', 'date', 'coordinatorName', 'coordinatorContact'])) ||
        // NO coordinator branch here, on purpose.
        //
        // It used to read:
        //   existing().coordinatorContact == request.auth.token.email &&
        //   diff.hasOnly(['status']) && status in ['approved','declined']
        //
        // coordinatorContact is written by the STUDENT when they create the
        // request, so a student naming their own address satisfied it from
        // their own session. It did not credit hours (students/{uid}.hours is
        // server-only), but the organization's queue filters on status ==
        // 'pending', so a self-settled request vanished from their list while
        // the student's dashboard showed it as approved.
        //
        // Both transitions now go through POST /api/hours/approve, which
        // verifies an actual relationship before settling anything. See
        // docs/ARCHITECTURE-PRINCIPLES.md §2.
        isDeveloper()
      );
      allow delete: if isSignedIn() && (
        existing().studentId == request.auth.uid ||
        isDeveloper()
      );
    }

    match /interestRequests/{reqId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isDeveloper()) && isValidId(reqId);
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && isValidId(reqId) && (
        (incoming().studentId == request.auth.uid && isValidInterestRequest(incoming()) && incoming().keys().hasOnly(['studentId', 'studentName', 'email', 'categories', 'description', 'createdAt', 'status'])) || 
        isDeveloper()
      );
      allow update: if isSignedIn() && isValidId(reqId) && (
        (existing().studentId == request.auth.uid && isValidInterestRequest(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['categories', 'description'])) || 
        isDeveloper()
      );
      allow delete: if isDeveloper();
    }

    // chats/ and messages/ deliberately have NO rules.
    //
    // They had a complete rule set — read, create, update, delete, participant
    // checks, a nested messages subcollection — and ZERO code. Nothing in the
    // application ever read or wrote either collection. That is not harmless:
    // it is live, reachable permission on the production database that no test
    // covers and no feature justifies, and it made the project look like it had
    // messaging when it did not.
    //
    // Messaging is a v2 item in docs/ROADMAP.md. Write these rules then, from
    // the data shape the feature actually turns out to need, rather than
    // inheriting a guess. Deleted rules are recoverable from git history.

    // ── Org → Student recommendations ──
    // An org writes a reference for a student after working with them.
    // ID format: {orgUid}_{studentUid}_{opportunityId}
    match /recommendations/{recId} {
      // The student it is about, and the org that wrote it. Nobody else.
      //
      // There used to be a bare `isVerifiedOrg()` here as well. That only
      // checks that the caller's own users doc says role == 'organization' —
      // which anyone gets, free and instantly, by signing up — so every
      // organization could read every reference written about every student on
      // the platform, including ones from organizations it has nothing to do
      // with. The authorising fact has to be ownership of this document, never
      // the caller's self-declared role.
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.orgId == request.auth.uid ||
        isDeveloper()
      );
      // Only the org that worked with the student can write. One per opportunity.
      // `orgId == request.auth.uid` proves you are the org. It never proved you
      // had anything to do with the opportunity you are writing a reference
      // about — anyone can register as an organization instantly and free, so
      // a throwaway account could author references for any student on any
      // opportunity. The opportunity is an exact document path, so rules CAN
      // check it: you may only write a reference against an opportunity you own.
      //
      // This is a partial proof and deliberately labelled as one. The full
      // test — did this student actually volunteer with us — is a QUERY across
      // applications, which rules cannot run. That belongs behind a server
      // endpoint alongside POST /api/hours/approve. Until it exists, an org can
      // still write a reference for a student who never applied to its own
      // opportunity; it can no longer touch anyone else's.
      // No client create. The authorising fact is "did this student actually
      // volunteer with this organization", which is a QUERY across
      // applications, and rules can only read an exact document path — so no
      // amount of tightening here could ever express it. Ownership of the
      // opportunity was the closest this could get, and it still let an org
      // write a reference about a student who never applied.
      //
      // POST /api/recommendations/create runs the query with the Admin SDK
      // (bypassing these rules by design) and is now the only door. Same
      // reasoning, and same shape, as hours: see the students/ block above.
      allow create: if false;
      allow update: if isVerifiedOrg() && existing().orgId == request.auth.uid &&
                       isValidRecommendation(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['text', 'rating']);
      allow delete: if isDeveloper() || (isVerifiedOrg() && existing().orgId == request.auth.uid);
    }

    // ── Student → Org ratings ──
    // A student rates an org after completing volunteer work with them.
    // ID format: {studentUid}_{orgUid}_{opportunityId}
    match /orgRatings/{ratingId} {
      // Scoped to the two parties and developers — NOT every signed-in account.
      //
      // This was `allow read: if isSignedIn()` on the grounds that ratings are
      // shown on organization profiles. But the document carries `studentId`,
      // and the id itself is {studentUid}_{orgUid}_{opportunityId}, so a public
      // read told any organization exactly which volunteer left it one star —
      // and let any org read every other org's ratings. The raters here are
      // minors, and a review system that de-anonymises them is worse than no
      // review system.
      //
      // Nothing renders ratings anywhere yet, so nothing breaks by closing this
      // now. When a public average is actually displayed, it should come from an
      // aggregate the server maintains (like leaderboards/) rather than by
      // opening the raw documents back up.
      allow read: if isSignedIn() && (
        resource.data.orgId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isDeveloper()
      );
      // Only the student who volunteered can rate. One per opportunity.
      // Same shape as recommendations above, mirrored. A student could rate any
      // organization for any opportunity, including ones that organization
      // never posted — so ratings could be manufactured against a competitor
      // or a stranger. The opportunity is an exact path, so require that it
      // exists and actually belongs to the org being rated.
      //
      // Also partial: proving the student COMPLETED work there is a query, and
      // belongs on the server. Nothing displays ratings anywhere yet, so this
      // closes the forgery surface before the feature has an audience.
      // No client create, mirroring recommendations above. Ratings are a trust
      // signal students use to choose who to volunteer with, so "I actually
      // volunteered here" has to be proven, and that proof is a query.
      // POST /api/ratings/create is the only door, and it reads the org from
      // the opportunity rather than the request, so the rater cannot choose
      // which organization their stars land on.
      allow create: if false;
      // Students can edit their own rating within a window (enforced
      // client-side — which is why the bounds have to be re-checked here).
      allow update: if isSignedIn() && existing().studentId == request.auth.uid &&
                       isValidOrgRating(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['stars', 'comment']);
      allow delete: if isDeveloper();
    }
  }
}