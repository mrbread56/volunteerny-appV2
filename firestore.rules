rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedStudent() {
      return isSignedIn() && (
        isDeveloper() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
      );
    }

    function isVerifiedOrg() {
      return isSignedIn() && (
        isDeveloper() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organization'
      );
    }

    // The bootstrap allowlist. Keep in sync with VITE_DEVELOPER_EMAILS in .env —
    // `npm run deploy:rules` refuses to deploy when the two disagree, because a
    // developer email that is in the app but not here gets the whole Control
    // Room UI and permission-denied on every privileged operation, which reads
    // as "the site is broken" rather than "you are not authorized".
    //
    // Rules cannot read environment variables, so this list has to be literal.
    // It is only the bootstrap: once users/{uid}.role == 'developer' the first
    // clause below carries the session, and an existing developer can promote
    // another account by writing that field (see the /users match block).
    function developerEmails() {
      return ['kiamehrmetanat@gmail.com'];
    }

    function isDeveloper() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer' ||
        // email_verified matters here. Firebase does not require ownership proof
        // to create an account with a given address, so without it anyone could
        // register an unclaimed allowlisted address and be handed developer.
        // Every current developer signs in with Google, which verifies.
        (request.auth.token.email in developerEmails() && request.auth.token.email_verified == true)
      );
    }

    // NEVER call this from an `allow read` or `allow list` rule. On a list
    // query the path wildcard has no single value to bind to, so matches()
    // errors and the whole query is denied — which is why the student
    // dashboard, the org directory and the hours list all came back
    // permission-denied while collections without this check worked fine.
    // Split the rule instead: `allow get` may use isValidId, `allow list` must
    // constrain on resource.data (see /students, which already does this).
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Reading a key that is absent from a map is an EVALUATION ERROR in the
    // rules language, and an erroring condition denies the request. So
    // `data.foo == null` does not mean "foo is absent or null" — it blows up
    // whenever foo is absent, which denied every genuine browser signup
    // (Signup.tsx never sends previousExperience/loggedHours/isBanned) while
    // Admin-SDK test scripts, which bypass rules entirely, looked fine.
    //
    // `data.get(field, null) == null` is the safe form: it returns the default
    // for an absent key and null for a present-but-null one, covering both
    // "optional" cases without ever erroring. Every optional-field check below
    // uses it. Do not reintroduce bare `data.x == null`.
    function absent(data, field) {
      return data.get(field, null) == null;
    }

    // --- Entity Validators ---

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['student', 'organization'] &&
             (absent(data, 'twoFactorEnabled') || data.twoFactorEnabled is bool) &&
             data.createdAt == request.time;
    }

    function isValidStudent(data) {
       return data.uid == request.auth.uid &&
              data.fullName is string && data.fullName.size() <= 100 &&
              (absent(data, 'school') || (data.school is string && data.school.size() <= 100)) &&
              (absent(data, 'grade') || data.grade in ['9', '10', '11', '12', '']) &&
              (absent(data, 'neighborhood') || (data.neighborhood is string && data.neighborhood.size() <= 100)) &&
              (absent(data, 'interests') || (data.interests is list && data.interests.size() <= 50)) &&
              (absent(data, 'skills') || (data.skills is list && data.skills.size() <= 50)) &&
              (absent(data, 'availability') || (data.availability is list && data.availability.size() <= 50)) &&
              (absent(data, 'previousExperience') || (data.previousExperience is string && data.previousExperience.size() <= 5000)) &&
              // resumeUrl and passportUrl are not URLs: they hold the whole file
              // as a base64 data URI inside this document. Every other field here
              // is capped and these two were not, which is a resource-exhaustion
              // hole AND a correctness one — Firestore rejects any document over
              // 1 MiB, so an oversized upload made the student's entire profile
              // unsaveable rather than just refusing the file. 400_000 each keeps
              // both plus the rest of the document comfortably under the limit.
              (absent(data, 'resumeUrl') || (data.resumeUrl is string && data.resumeUrl.size() <= 400000)) &&
              (absent(data, 'passportUrl') || (data.passportUrl is string && data.passportUrl.size() <= 400000)) &&
              (absent(data, 'loggedHours') || (data.loggedHours is list && data.loggedHours.size() <= 500)) &&
              (absent(data, 'isBanned') || data.isBanned is bool);
    }

    function isValidOrganization(data) {
      return data.uid == request.auth.uid &&
             data.organizationName is string && data.organizationName.size() <= 100 &&
             (absent(data, 'mission') || (data.mission is string && data.mission.size() <= 2000)) &&
             data.contactEmail is string &&
             data.northYorkConfirmed is bool &&
             (absent(data, 'phone') || data.phone is string) &&
             (absent(data, 'websiteUrl') || data.websiteUrl is string) &&
             (absent(data, 'organizationType') || data.organizationType is string) &&
             (absent(data, 'address') || data.address is string) &&
             (absent(data, 'isBanned') || data.isBanned is bool) &&
             (absent(data, 'coordinates') || (data.coordinates is map && data.coordinates.lat is number && data.coordinates.lng is number));
    }

    function isValidOpportunity(data) {
      return data.orgId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 5000 &&
             data.location is string &&
             data.category is string &&
             (absent(data, 'orgName') || data.orgName is string) &&
             (absent(data, 'requirements') || data.requirements is string) &&
             (absent(data, 'maxVolunteers') || data.maxVolunteers is int) &&
             (absent(data, 'skillsNeeded') || data.skillsNeeded is list) &&
             (absent(data, 'exclusives') || data.exclusives is list) &&
             (absent(data, 'timeCommitment') || data.timeCommitment is string) &&
             (absent(data, 'isVirtual') || data.isVirtual is bool) &&
             (absent(data, 'scheduleType') || data.scheduleType is string) &&
             (absent(data, 'shifts') || data.shifts is list) &&
             (absent(data, 'coordinates') || (data.coordinates is map && data.coordinates.lat is number && data.coordinates.lng is number)) &&
             data.createdAt == (resource == null ? request.time : resource.data.createdAt);
    }

    function isValidApplication(data) {
       return data.studentId == (resource == null ? request.auth.uid : resource.data.studentId) &&
              data.opportunityId is string &&
              // 'reviewed' is in the Application type and OrgOpportunityApplicants
             // writes it, but it was missing here, so every "Mark as reviewed"
             // click was rejected with permission-denied. It passed in demo mode
             // because demo mode never reaches Firestore.
             data.status in ['pending', 'reviewed', 'accepted', 'rejected', 'terminated', 'waitlist'] &&
              (absent(data, 'opportunityTitle') || data.opportunityTitle is string) &&
              (absent(data, 'studentName') || data.studentName is string) &&
              (absent(data, 'previousExperience') || data.previousExperience is string) &&
              (absent(data, 'message') || data.message is string) &&
              data.appliedAt == (resource == null ? request.time : resource.data.appliedAt) &&
              // Same 400 KB cap the student document already enforces. Without it an
             // application could carry most of the 1 MiB document limit.
             (absent(data, 'resumeUrl') || (data.resumeUrl is string && data.resumeUrl.size() <= 400000));
    }

    function isValidSavedOpportunity(data) {
      return data.studentId == request.auth.uid &&
             data.opportunityId is string &&
             data.savedAt == request.time;
    }

    function isValidFeedback(data) {
      return data.userId == request.auth.uid &&
             data.userEmail is string &&
             data.type in ['bug', 'feature', 'ux', 'other'] &&
             data.subject is string && data.subject.size() <= 200 &&
             data.message is string && data.message.size() <= 10000 &&
             (absent(data, 'userRole') || data.userRole is string) &&
             (absent(data, 'id') || data.id is string) &&
             (absent(data, 'attachmentName') || data.attachmentName is string) &&
             (absent(data, 'attachmentSize') || data.attachmentSize is string) &&
             (absent(data, 'attachmentDescription') || data.attachmentDescription is string) &&
             // Capped like resumeUrl/passportUrl above: this is a base64 file
             // upload from the client and it had no size limit at all, so one
             // feedback ticket or safety report could be inflated to the 1 MiB
             // document ceiling.
             (absent(data, 'attachmentData') ||
               (data.attachmentData is string && data.attachmentData.size() <= 400000)) &&
             (absent(data, 'aiOverview') || data.aiOverview is map) &&
             (absent(data, 'developerReply') || data.developerReply is string) &&
             (absent(data, 'repliedAt') || data.repliedAt is string || data.repliedAt is timestamp) &&
             data.createdAt == (resource == null ? request.time : resource.data.createdAt);
    }

    function isValidReport(data) {
      return data.reportingUserId == request.auth.uid &&
             data.reportingUserEmail is string &&
             data.reportedUserId is string &&
             data.reason is string &&
             data.description is string &&
             data.status in ['pending', 'resolved', 'dismissed'] &&
             (absent(data, 'reportingUserName') || data.reportingUserName is string) &&
             (absent(data, 'reportedUserName') || data.reportedUserName is string) &&
             (absent(data, 'reportedUserRole') || data.reportedUserRole is string) &&
             (absent(data, 'id') || data.id is string) &&
             (absent(data, 'attachmentName') || data.attachmentName is string) &&
             (absent(data, 'attachmentSize') || data.attachmentSize is string) &&
             (absent(data, 'attachmentDescription') || data.attachmentDescription is string) &&
             // Capped like resumeUrl/passportUrl above: this is a base64 file
             // upload from the client and it had no size limit at all, so one
             // feedback ticket or safety report could be inflated to the 1 MiB
             // document ceiling. The cap stays even though new reports carry
             // only a Storage URL: documents written before that migration
             // still hold inline base64, and every update to one of them is
             // re-validated through here.
             (absent(data, 'attachmentData') ||
               (data.attachmentData is string && data.attachmentData.size() <= 400000)) &&
             // Current reports store the attachment in Firebase Storage
             // (reports/{uid}/... per storage.rules) and carry only the URL.
             (absent(data, 'attachmentUrl') || data.attachmentUrl is string) &&
             (absent(data, 'aiOverview') || data.aiOverview is map) &&
             data.createdAt == (resource == null ? request.time : resource.data.createdAt);
    }

    // These two exist so `update` can enforce exactly what `create` enforces.
    // Both bodies used to live inline in their `create` rule only, and the
    // matching `update` checked nothing but which keys changed — so the owner
    // could create a valid 1-to-5 rating and then PATCH it to 999999, push the
    // text past its cap, or bolt on arbitrary new fields up to the 1 MiB
    // document limit. Every other collection in this file already re-validates
    // on update; these were the two newest and the two that did not.
    function isValidRecommendation(data) {
      return data.studentId is string &&
             data.opportunityId is string &&
             data.text is string && data.text.size() <= 1000 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidOrgRating(data) {
      return data.orgId is string &&
             data.opportunityId is string &&
             data.stars is number && data.stars >= 1 && data.stars <= 5 &&
             data.comment is string && data.comment.size() <= 500;
    }

    function isValidHoursRequest(data) {
      return data.studentId is string &&
             data.studentName is string &&
             data.studentEmail is string &&
             data.activity is string &&
             data.organization is string &&
             // Bounded. Every other field here is capped; this one was not, so a
             // student could file a request for any number. It could never be
             // credited (the server caps a single approval at 24), but it could
             // fill an organization's queue with absurd claims.
             data.hours is number && data.hours > 0 && data.hours <= 24 &&
             data.date is string &&
             data.coordinatorName is string &&
             data.coordinatorContact is string &&
             data.status in ['pending', 'approved', 'declined'] &&
             data.requestedAt is string;
    }

    function isValidInterestRequest(data) {
      return data.studentId == request.auth.uid &&
             data.studentName is string &&
             data.email is string &&
             data.categories is list &&
             data.description is string &&
             data.createdAt == request.time &&
             data.status == 'pending';
    }

    // --- Match Blocks ---

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isDeveloper()) && isValidId(uid);
      // Only the developer console enumerates accounts.
      allow list: if isDeveloper();
      allow create: if isSignedIn() && request.auth.uid == uid && isValidId(uid) && isValidUser(incoming());
      // twoFactorEnabled is read by the client MFA gate: when it is false the
      // gate is skipped entirely. This rule previously accepted any bool from
      // the account owner, so an organization or developer could PATCH their
      // own user doc to { twoFactorEnabled: false } and permanently opt out of
      // 2FA. Students may still toggle it (it is optional for them); everyone
      // else may only leave it alone or turn it on.
      allow update: if isSignedIn() && request.auth.uid == uid && isValidId(uid) &&
                      incoming().role == existing().role &&
                      incoming().uid == existing().uid &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().email == existing().email &&
                      (absent(incoming(), 'twoFactorEnabled') || incoming().twoFactorEnabled is bool) &&
                      (
                        incoming().get('twoFactorEnabled', null) == existing().get('twoFactorEnabled', null) ||
                        incoming().get('twoFactorEnabled', null) == true ||
                        existing().role == 'student'
                      );
      allow delete: if false;
      allow read, write: if isDeveloper();
    }

    match /students/{uid} {
      // The student, and developers. NOT organizations.
      //
      // isVerifiedOrg() used to be here, which meant any account with
      // role == 'organization' could read ANY student document given a uid —
      // and these documents carry resumeUrl and passportUrl, whole identity
      // documents base64-encoded inline, for students who are mostly minors.
      // An organization account is free and instant, so that was a standing
      // invitation.
      //
      // Whether a student applied to one of this organization's opportunities
      // is a query, and rules can only read an exact document path, so this
      // could not be narrowed here. Organizations now read through
      // GET /api/students/:id/review-profile, which runs that query and
      // returns an allow-listed subset — deliberately without passportUrl,
      // which no organization-facing screen has ever shown.
      allow get: if isSignedIn() && (isOwner(uid) || isDeveloper()) && isValidId(uid);
      // Only students and developers can run list queries
      allow list: if isSignedIn() && (isOwner(uid) || isDeveloper());
      
      allow create: if isSignedIn() && request.auth.uid == uid && isValidId(uid) && isValidStudent(incoming()) && 
                    (!('loggedHours' in incoming()) || incoming().loggedHours.size() == 0);
      // `hours` is the denormalised total of `loggedHours` and is what the
      // leaderboard rebuild orders by, so it is exactly as self-crediting as the
      // array is: the owner may not touch either. The organization writes both
      // in one updateDoc when it approves hours, so hasOnly must name both —
      // with only ['loggedHours'] the combined write is rejected outright.
      // NO CLIENT may write loggedHours or hours — not the student, and no
      // longer the organization either.
      //
      // There used to be an organization branch here guarded by
      // isVerifiedOrg() && hasOnly(['loggedHours','hours']). hasOnly() restricts
      // WHICH fields are written, never WHOSE document they are written to, and
      // isVerifiedOrg() only checks that the caller's own users doc says
      // role == 'organization' — which anyone gets, free and instantly, by
      // signing up. So any account could credit OR erase the volunteer hours of
      // any student whose uid it knew. Ontario requires 40
      // community-involvement hours to graduate, making that a forged or
      // destroyed graduation record.
      //
      // The missing test is "did this student actually volunteer with this
      // organization", which needs a query across applications and
      // opportunities. Rules can only read an exact document path, so they
      // cannot answer it — no amount of tightening here would have. The
      // authority now lives in POST /api/hours/approve, which runs that query
      // with the Admin SDK (bypassing these rules by design) and writes the
      // array and the total in one transaction.
      //
      // Deliberately no organization branch below. Adding one back re-opens the
      // hole; scripts/check-security.ts asserts it stays shut.
      allow update: if isSignedIn() && isValidId(uid) && (
        (isOwner(uid) && isValidStudent(incoming()) && !incoming().diff(existing()).affectedKeys().hasAny(['loggedHours', 'hours'])) ||
        isDeveloper()
      );
      allow delete: if isDeveloper();
    }

    match /organizations/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      // The student dashboard and the hours-logging form both browse the org
      // directory, so any signed-in user may list it — same exposure the
      // per-document rule already allowed.
      allow list: if isSignedIn();
      // craVerified / verificationStatus are trust signals shown to students
      // choosing who to volunteer with. An organization must never be able to
      // set them on itself - the client used to write craVerified: true purely
      // because the org typed a number, and these rules allowed it, so any org
      // could self-issue a verified badge with a single request.
      allow create: if isSignedIn() && request.auth.uid == uid && isValidId(uid) && isValidOrganization(incoming()) &&
                      incoming().get('craVerified', false) == false;
      allow update: if isSignedIn() && isValidId(uid) && (
        (request.auth.uid == uid && isValidOrganization(incoming()) &&
         !incoming().diff(existing()).affectedKeys().hasAny(['craVerified', 'verificationStatus'])) ||
        isDeveloper()
      );
      allow delete: if isDeveloper();
    }

    match /opportunities/{opportunityId} {
      allow read: if true; // Public access to browse
      allow create: if isVerifiedOrg() && isValidOpportunity(incoming()) && isValidId(opportunityId);
      allow update: if isVerifiedOrg() && isValidId(opportunityId) &&
                      existing().orgId == request.auth.uid && 
                      isValidOpportunity(incoming());
      allow delete: if isVerifiedOrg() && isValidId(opportunityId) && existing().orgId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow get: if isSignedIn() && isValidId(applicationId) && (
        resource.data.studentId == request.auth.uid ||
        (exists(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)) &&
         get(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)).data.orgId == request.auth.uid) ||
        isDeveloper()
      );
      // Same ownership constraint, minus isValidId — see the note on that
      // function. Students list their own applications; an org lists the
      // applications to opportunities it owns.
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        (exists(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)) &&
         get(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)).data.orgId == request.auth.uid) ||
        isDeveloper()
      );
      
      // Allow students to apply either directly (pending) or to waitlist (waitlist)
      allow create: if isVerifiedStudent() && isValidId(applicationId) && isValidApplication(incoming()) && 
                    (incoming().status == 'pending' || incoming().status == 'waitlist');
                    
      allow update: if isSignedIn() && isValidId(applicationId) && isValidApplication(incoming()) && (
        // Student can withdraw (status changes to terminated) or update message/resume
        (isOwner(existing().studentId) && 
         (incoming().status == existing().status || incoming().status == 'terminated') &&
         incoming().diff(existing()).affectedKeys().hasOnly(['message', 'resumeUrl', 'status'])) ||
        // Org can update status, rejectionReason, and rejectionNote
        (exists(/databases/$(database)/documents/opportunities/$(existing().opportunityId)) &&
         get(/databases/$(database)/documents/opportunities/$(existing().opportunityId)).data.orgId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'rejectionNote'])) ||
        isDeveloper()
      );
      allow delete: if isOwner(resource.data.studentId) || isDeveloper();
    }

    match /savedOpportunities/{savedId} {
      allow read: if isOwner(resource.data.studentId) || isDeveloper();
      allow create: if isVerifiedStudent() && isValidSavedOpportunity(incoming()) && isValidId(savedId);
      allow delete: if isOwner(resource.data.studentId) || isDeveloper();
    }

    match /feedbacks/{feedbackId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper()) && isValidId(feedbackId);
      // The feedback page lists the tickets you filed; developers list them all.
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(feedbackId) && isValidFeedback(incoming());
      allow update: if isSignedIn() && isValidId(feedbackId) && (
        isDeveloper() || 
        (resource.data.userId == request.auth.uid && isValidFeedback(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'subject']))
      );
      allow delete: if isDeveloper();
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && (resource.data.reportingUserId == request.auth.uid || resource.data.reportedUserId == request.auth.uid || isDeveloper()) && isValidId(reportId);
      allow list: if isSignedIn() && (resource.data.reportingUserId == request.auth.uid || resource.data.reportedUserId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && incoming().reportingUserId == request.auth.uid && isValidId(reportId) && isValidReport(incoming());
      allow update, delete: if isDeveloper();
    }

    // The materialised leaderboard. Clients only ever read it; it is built by
    // the server's Admin SDK (POST /api/leaderboard/refresh), which bypasses
    // these rules entirely. Keeping client writes closed to everyone — not even
    // developers — means a compromised dev account cannot forge rankings, and
    // documents the fact that aggregation is deliberately server-only.
    match /leaderboards/{leaderboardId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // OTP request counters, written only by the server's Admin SDK. Exposing
    // these to clients would let a user reset their own rate limit.
    match /otp_rate_limits/{uid} {
      allow read, write: if false;
    }

    match /hoursRequests/{reqId} {
      allow get: if isSignedIn() && isValidId(reqId) && (
        resource.data.studentId == request.auth.uid ||
        resource.data.coordinatorContact == request.auth.token.email ||
        isDeveloper()
      );
      // Students list their own logged hours; coordinators list the requests
      // addressed to them.
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.coordinatorContact == request.auth.token.email ||
        isDeveloper()
      );
      allow create: if isSignedIn() && isValidId(reqId) && (
        (incoming().studentId == request.auth.uid && isValidHoursRequest(incoming()) && incoming().status == 'pending') ||
        isDeveloper()
      );
      allow update: if isSignedIn() && isValidId(reqId) && (
        // Only student owner can edit their own pending requests
        (existing().studentId == request.auth.uid && 
         existing().status == 'pending' &&
         isValidHoursRequest(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['activity', 'organization', 'hours', 'date', 'coordinatorName', 'coordinatorContact'])) ||
        // NO coordinator branch here, on purpose.
        //
        // It used to read:
        //   existing().coordinatorContact == request.auth.token.email &&
        //   diff.hasOnly(['status']) && status in ['approved','declined']
        //
        // coordinatorContact is written by the STUDENT when they create the
        // request, so a student naming their own address satisfied it from
        // their own session. It did not credit hours (students/{uid}.hours is
        // server-only), but the organization's queue filters on status ==
        // 'pending', so a self-settled request vanished from their list while
        // the student's dashboard showed it as approved.
        //
        // Both transitions now go through POST /api/hours/approve, which
        // verifies an actual relationship before settling anything. See
        // docs/ARCHITECTURE-PRINCIPLES.md §2.
        isDeveloper()
      );
      allow delete: if isSignedIn() && (
        existing().studentId == request.auth.uid ||
        isDeveloper()
      );
    }

    match /interestRequests/{reqId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isDeveloper()) && isValidId(reqId);
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isDeveloper());
      allow create: if isSignedIn() && isValidId(reqId) && (
        (incoming().studentId == request.auth.uid && isValidInterestRequest(incoming())) || 
        isDeveloper()
      );
      allow update: if isSignedIn() && isValidId(reqId) && (
        (existing().studentId == request.auth.uid && isValidInterestRequest(incoming())) || 
        isDeveloper()
      );
      allow delete: if isDeveloper();
    }

    // chats/ and messages/ deliberately have NO rules.
    //
    // They had a complete rule set — read, create, update, delete, participant
    // checks, a nested messages subcollection — and ZERO code. Nothing in the
    // application ever read or wrote either collection. That is not harmless:
    // it is live, reachable permission on the production database that no test
    // covers and no feature justifies, and it made the project look like it had
    // messaging when it did not.
    //
    // Messaging is a v2 item in docs/ROADMAP.md. Write these rules then, from
    // the data shape the feature actually turns out to need, rather than
    // inheriting a guess. Deleted rules are recoverable from git history.

    // ── Org → Student recommendations ──
    // An org writes a reference for a student after working with them.
    // ID format: {orgUid}_{studentUid}_{opportunityId}
    match /recommendations/{recId} {
      // The student it is about, and the org that wrote it. Nobody else.
      //
      // There used to be a bare `isVerifiedOrg()` here as well. That only
      // checks that the caller's own users doc says role == 'organization' —
      // which anyone gets, free and instantly, by signing up — so every
      // organization could read every reference written about every student on
      // the platform, including ones from organizations it has nothing to do
      // with. The authorising fact has to be ownership of this document, never
      // the caller's self-declared role.
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.orgId == request.auth.uid ||
        isDeveloper()
      );
      // Only the org that worked with the student can write. One per opportunity.
      // `orgId == request.auth.uid` proves you are the org. It never proved you
      // had anything to do with the opportunity you are writing a reference
      // about — anyone can register as an organization instantly and free, so
      // a throwaway account could author references for any student on any
      // opportunity. The opportunity is an exact document path, so rules CAN
      // check it: you may only write a reference against an opportunity you own.
      //
      // This is a partial proof and deliberately labelled as one. The full
      // test — did this student actually volunteer with us — is a QUERY across
      // applications, which rules cannot run. That belongs behind a server
      // endpoint alongside POST /api/hours/approve. Until it exists, an org can
      // still write a reference for a student who never applied to its own
      // opportunity; it can no longer touch anyone else's.
      allow create: if isVerifiedOrg() && isValidId(recId) &&
                       incoming().orgId == request.auth.uid &&
                       isValidRecommendation(incoming()) &&
                       exists(/databases/$(database)/documents/opportunities/$(incoming().opportunityId)) &&
                       get(/databases/$(database)/documents/opportunities/$(incoming().opportunityId)).data.orgId == request.auth.uid;
      allow update: if isVerifiedOrg() && existing().orgId == request.auth.uid &&
                       isValidRecommendation(incoming()) &&
                       !incoming().diff(existing()).affectedKeys().hasAny(['orgId', 'studentId', 'opportunityId']);
      allow delete: if isDeveloper() || (isVerifiedOrg() && existing().orgId == request.auth.uid);
    }

    // ── Student → Org ratings ──
    // A student rates an org after completing volunteer work with them.
    // ID format: {studentUid}_{orgUid}_{opportunityId}
    match /orgRatings/{ratingId} {
      // Anyone signed in can read ratings (they're shown on org profiles).
      allow read: if isSignedIn();
      // Only the student who volunteered can rate. One per opportunity.
      // Same shape as recommendations above, mirrored. A student could rate any
      // organization for any opportunity, including ones that organization
      // never posted — so ratings could be manufactured against a competitor
      // or a stranger. The opportunity is an exact path, so require that it
      // exists and actually belongs to the org being rated.
      //
      // Also partial: proving the student COMPLETED work there is a query, and
      // belongs on the server. Nothing displays ratings anywhere yet, so this
      // closes the forgery surface before the feature has an audience.
      allow create: if isSignedIn() && isValidId(ratingId) &&
                       incoming().studentId == request.auth.uid &&
                       isValidOrgRating(incoming()) &&
                       exists(/databases/$(database)/documents/opportunities/$(incoming().opportunityId)) &&
                       get(/databases/$(database)/documents/opportunities/$(incoming().opportunityId)).data.orgId == incoming().orgId;
      // Students can edit their own rating within a window (enforced
      // client-side — which is why the bounds have to be re-checked here).
      allow update: if isSignedIn() && existing().studentId == request.auth.uid &&
                       isValidOrgRating(incoming()) &&
                       !incoming().diff(existing()).affectedKeys().hasAny(['studentId', 'orgId', 'opportunityId']);
      allow delete: if isDeveloper();
    }
  }
}