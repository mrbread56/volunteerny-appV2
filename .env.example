# ── API Configuration ──
VITE_API_URL=http://localhost:3001
# Comma-separated. Deliberately a placeholder: this file is committed to a
# public repository, and a real address here both exposes personal data and
# tells an attacker exactly which account to compromise for developer access.
# Put the real list in .env (gitignored) and in the deployment environment.
VITE_DEVELOPER_EMAILS=you@example.com

# ── Firebase Configuration (move from firebase-applet-config.json) ──
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_DATABASE_ID=your-database-id

# ── Server-side (not exposed to client) ──

# RESEND_API_KEY — required. Without it no two-factor code can be delivered.
RESEND_API_KEY=re_xxx

# MAIL_FROM — REQUIRED IN PRODUCTION, and the highest-risk value in this file.
# Organization accounts are created with twoFactorEnabled: true, so every org
# login needs an emailed code. If this sender's domain is not verified in
# Resend, Resend rejects the message and NO ORGANIZATION CAN LOG IN AT ALL.
# Verify a domain at https://resend.com/domains, then set:
MAIL_FROM=Volunteer North York <noreply@your-verified-domain.com>

# APP_URL — the origin the app is SERVED from. Every button in every
# transactional email is built from it, and in production it is also the CORS
# allowed origin.
#
# This is NOT the MAIL_FROM domain. That domain is verified in Resend so it can
# send mail; it serves no website. Both of these defaulted to it, so every email
# button pointed at a host that does not exist as a site — mail arrived, branding
# looked right, every call to action was dead.
#
# Unset in production, the fallback is CANONICAL_APP_ORIGIN in server/appUrl.ts
# (currently https://volunteerny-app-v2.vercel.app) and a warning is logged. Set
# it explicitly in the deployment environment — on Vercel it is NOT provided
# automatically. Verify with: npm run check:email
APP_URL=http://localhost:3000

# GEMINI_API_KEY — optional. Powers AI triage of feedback tickets at
# POST /api/feedback/analyze. Without it that endpoint returns a clear
# "unavailable" response and the rest of the feedback flow still works.
GEMINI_API_KEY=

GOOGLE_CLOUD_PROJECT=your-gcp-project

# Firestore database ID (this project uses a NAMED database, not "(default)").
# Run `npm run check:firebase` to list which databases exist.
VITE_FIREBASE_DATABASE_ID=
FIREBASE_DATABASE_ID=

# Authenticates the nightly leaderboard rebuild (GET /api/leaderboard/refresh).
# Vercel sends it as `Authorization: Bearer <value>` on cron invocations; set the
# SAME value in the Vercel project's environment variables. Without it the route
# fails closed and the scheduled rebuild simply does not run — which is the
# correct trade, because the fallback it replaced (trusting an x-vercel-cron
# header anyone can send) made this an unauthenticated database-scan endpoint.
CRON_SECRET=
VITE_APPCHECK_SITE_KEY=
