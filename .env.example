# ── API Configuration ──
VITE_API_URL=http://localhost:3001
VITE_DEVELOPER_EMAILS=kiamehrmetanat@gmail.com

# ── Firebase Configuration (move from firebase-applet-config.json) ──
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_DATABASE_ID=your-database-id

# ── Server-side (not exposed to client) ──

# RESEND_API_KEY — required. Without it no two-factor code can be delivered.
RESEND_API_KEY=re_xxx

# MAIL_FROM — REQUIRED IN PRODUCTION, and the highest-risk value in this file.
# Organization accounts are created with twoFactorEnabled: true, so every org
# login needs an emailed code. If this sender's domain is not verified in
# Resend, Resend rejects the message and NO ORGANIZATION CAN LOG IN AT ALL.
# Verify a domain at https://resend.com/domains, then set:
MAIL_FROM=Volunteer North York <noreply@your-verified-domain.com>

# APP_URL — origin used to build links inside outbound email. Must match the
# origin actually serving the request, or codes link users to the wrong site.
APP_URL=http://localhost:3000

# GEMINI_API_KEY — optional. Powers AI triage of feedback tickets at
# POST /api/feedback/analyze. Without it that endpoint returns a clear
# "unavailable" response and the rest of the feedback flow still works.
GEMINI_API_KEY=

GOOGLE_CLOUD_PROJECT=your-gcp-project

# Firestore database ID (this project uses a NAMED database, not "(default)").
# Run `npm run check:firebase` to list which databases exist.
VITE_FIREBASE_DATABASE_ID=
FIREBASE_DATABASE_ID=
