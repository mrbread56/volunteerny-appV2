rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions for security
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidImage() {
      // SVG is excluded deliberately.
      //
      // contentType is whatever the UPLOADER declares — the client passes
      // `file.type` straight through — so 'image/.*' accepted 'image/svg+xml',
      // and an SVG is a document that can carry script. Organization logos are
      // world-readable (`allow read: if true`), so that produced a permanent,
      // publicly addressable, attacker-controlled page hosted under this
      // project's own bucket. It runs on the storage origin rather than the app
      // origin, so it is not session theft — it is our domain lending its name
      // to someone else's content.
      //
      // Raster only. Every real use here is a photo or a logo.
      return request.resource.contentType.matches('image/(png|jpe?g|gif|webp|avif)');
    }
    
    function isValidPdf() {
      return request.resource.contentType == 'application/pdf';
    }
    
    function isSafeSize(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    match /{allPaths=**} {
      // Default deny
      allow read, write: if false;
    }
    
    function callerRole() {
      // MUST name the live database. This read still pointed at the
      // pre-migration AI-Studio database after production moved to
      // `volunteerny`, and storage.rules was not part of that commit — so the
      // developer branches below authorized against a stale copy. It failed in
      // BOTH directions at once and silently: a developer demoted or deleted
      // since the migration still passed from their leftover document, while a
      // developer promoted after it had no document there at all, so the get()
      // errored and the rule denied. Keep this in step with
      // FIREBASE_DATABASE_ID and firebase.json.
      return firestore.get(/databases/volunteerny/documents/users/$(request.auth.uid)).data.role;
    }

    function isOrgOrDeveloper() {
      return isSignedIn() && (callerRole() == 'organization' || callerRole() == 'developer');
    }

    // Students can upload resumes and profile pictures (max 5MB).
    //
    // Read was `isSignedIn()`, i.e. ANY authenticated account could fetch ANY
    // student's resume — and these are high-school students, so those files
    // carry minors' names, addresses and phone numbers. Every other student on
    // the platform had access. Restricted to the owner plus the organizations
    // that actually review applications.
    // …and `isOrgOrDeveloper()` was still far too wide. Anyone can register as
    // an organization instantly and for free, so that clause let ANY such
    // account read ANY student's resume, given only the path — no application,
    // no relationship, no connection to that student at all. Whether an
    // organization may see a given student's file depends on whether that
    // student applied to one of its opportunities, and that is a QUERY, which
    // Storage rules cannot run — the same limit that moved the equivalent
    // Firestore read to GET /api/students/:id/review-profile. So the owner
    // reads their own files and nobody else does. Do not widen this back to a
    // role check: the role is self-declared and proves nothing.
    match /students/{userId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
                   && (isValidImage() || isValidPdf())
                   && isSafeSize(5);
    }
    
    /*
     * The organizations/ block is deleted, not commented out.
     *
     * It granted `allow read: if true` — world-readable, signed-out included —
     * on a path NOTHING writes. There is no logo upload anywhere in the app and
     * no logo field on the organisation profile; the only three
     * uploadFileToStorage call sites write students/, reports/ and feedbacks/.
     * A standing public grant on a live bucket, guarding a feature that does
     * not exist, is worth removing rather than leaving for someone to trip over.
     *
     * purgeAccount still sweeps the organizations/{uid}/ prefix, which is
     * correct: legacy objects may exist, and deleting them needs no rule.
     * Restore this block from git history if a logo feature is ever built.
     */
    
    // chat_attachments had rules but the chat feature has zero application
    // code; its Firestore-side rules were already deleted for the same reason
    // (see firestore.rules, "chats/ and messages/ deliberately have NO rules").
    // Dead rules that reference a collection that does not exist only ever
    // evaluate to deny, so they are removed here too.

    // Safety-report evidence (max 5MB, images/PDFs). The bytes live here and
    // the reports/{id} Firestore document carries only the URL — screenshots
    // describing incidents with minors' accounts used to sit inline in the
    // document itself. Owner plus staff, mirroring the Firestore reports rules.
    match /reports/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || callerRole() == 'developer');
      allow write: if isSignedIn() && request.auth.uid == userId
                   && (isValidImage() || isValidPdf())
                   && isSafeSize(5);
    }

    // Feedback attachments (max 5MB, images/PDFs). Feedback often contains
    // screenshots of the reporter's own account, so it is owner + staff only —
    // this was also readable by every signed-in user.
    match /feedbacks/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || callerRole() == 'developer');
      allow write: if isSignedIn() && request.auth.uid == userId
                   && (isValidImage() || isValidPdf())
                   && isSafeSize(5);
    }
  }
}
