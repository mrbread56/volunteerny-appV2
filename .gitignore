node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Firebase config — contains API keys / secrets; move to .env
firebase-applet-config.json
firebase-blueprint.json

# Office binaries (tracked as exploded XML in .cortex/)
*.{xlsx,xlsm,docx,dotx,pptx}
# Sync manifests (local cache, regenerable)
.cortex/manifests/
.vercel

test-results/
playwright-report/

# ── Build artifacts and scratch files ──
# A 1.1MB compiled Vite bundle (index.js) and a stray Home_Overwritten.tsx were
# committed to the repo root, alongside ~40 one-off .cjs/.py scripts left over
# from earlier patch work. They were unreferenced by any config and made the
# project look unfinished to anyone opening it. These patterns stop that
# recurring; put throwaway scripts in scripts/ or outside the repo.
index.js
bundle.js
*_Overwritten.tsx
*.patch
server_out.txt
_probe*.ts
_tmp*
script-grep*.cjs
strip_*.cjs
revert_*.cjs

# Database snapshots from `npm run backup`. These contain student personal data
# — names, emails, schools, and base64 resume/passport uploads for people who
# are mostly minors. Never commit one.
backups/

# Scratch output from design and test runs. Regenerated on demand; none of it
# is a source of truth, and screenshots in particular bloat the repo fast.
# design-archive/ held mockups for redesigns that were all rejected — it was
# deleted rather than carried forward. The tracked HTML is still in git history
# if a reference is ever needed.
design-archive/
*.timestamp-*.mjs

# Third-party agent skills installed with `npx skills add`. Regenerable, MIT
# licensed, and not this project's code — reinstall rather than vendor them.
# The installer writes BOTH of these: .agents/ is the source, .claude/skills/
# is a per-agent copy, and missing the second one silently commits 24 files.
.agents/
.claude/skills/
skills-lock.json
